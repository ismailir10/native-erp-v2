// Buku data model. Invariants live in .agents/skills/accounting-rules/SKILL.md.
// Money is BigInt minor units of the entity's functional currency (IDR = whole Rupiah). Balances are never stored — always derived from JournalLine.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EntityKind {
  PT
  CV
  PERORANGAN
  BADAN_USAHA_ASING
}

enum AccountType {
  ASET
  LIABILITAS
  EKUITAS
  PENDAPATAN
  BEBAN
}

enum NormalBalance {
  DEBIT
  CREDIT
}

/// Current vs non-current, from the section a Neraca file lists an account under (mapping hint only).
enum AccountTerm {
  CURRENT
  NON_CURRENT
}

enum TaxTag {
  PPN_KELUARAN
  PPN_MASUKAN
  PPH_21
  PPH_23
  PPH_4_2
  PPH_25
}

enum BankCode {
  BCA
  MANDIRI
  BRI
  SMBC
  GENERIC
}

enum PeriodStatus {
  OPEN
  LOCKED
}

enum TxStatus {
  POSTED
  NEEDS_REVIEW
  REVIEWED
}

enum ClassifyMethod {
  TRANSFER
  RULE
  MEMORY
  AI
  HEURISTIC
  MANUAL
}

enum EntryKind {
  OPENING
  BANK
  RECLASS
  ADJUSTMENT
  IMPORTED
}

enum MapMethod {
  PRIOR
  NAME
  KEYWORD
  AI
  MANUAL
  NEW
}

enum LedgerMode {
  LEDGER
  NERACA
}

enum CurrencyMode {
  FUNCTIONAL
  CONVERT
}

enum LedgerImportStatus {
  DRAFT
  POSTED
}

enum CheckSeverity {
  BLOCK
  REVIEW
  INFO
}

enum RateKind {
  SPOT
  AVERAGE
}

enum RateSource {
  MANUAL
  FILE
}

enum Direction {
  IN
  OUT
}

model Firm {
  id        String         @id @default(cuid())
  name      String
  createdAt DateTime       @default(now())
  clients   Client[]
  rules     Rule[]
  aiUsage   AiUsage[]
  rates     ExchangeRate[]
  members   FirmMember[]
}

model Client {
  id            String               @id @default(cuid())
  firmId        String
  firm          Firm                 @relation(fields: [firmId], references: [id])
  name          String
  industry      String?
  createdAt     DateTime             @default(now())
  entities      Entity[]
  accounts      Account[]
  periods       Period[]
  rules         Rule[]
  memories      Memory[]
  ledgerImports LedgerImport[]
  schedules     AdjustmentSchedule[]
  proposals     ProposedEntry[]
  coaVersion    Int                  @default(1)

  @@index([firmId])
}

model Entity {
  id                 String               @id @default(cuid())
  firmId             String
  clientId           String
  client             Client               @relation(fields: [clientId], references: [id])
  name               String
  shortName          String
  kind               EntityKind
  npwp               String?
  /// ISO 4217 code; journal amounts of this entity are minor units of it (ADR 0006). Registry: lib/fx/currency.ts.
  functionalCurrency String               @default("IDR")
  bankAccounts       BankAccount[]
  entries            JournalEntry[]
  sourceAccounts     SourceAccount[]
  schedules          AdjustmentSchedule[]
  proposals          ProposedEntry[]

  @@index([clientId])
}

/// Chart of accounts is per Client (shared by its entities) so combined reports line up by code.
model Account {
  id              String               @id @default(cuid())
  firmId          String
  clientId        String
  client          Client               @relation(fields: [clientId], references: [id])
  code            String
  name            String
  type            AccountType
  normalBalance   NormalBalance
  fsLine          String
  isBank          Boolean              @default(false)
  isIntercompany  Boolean              @default(false)
  isClearing      Boolean              @default(false)
  isSuspense      Boolean              @default(false)
  isRetained      Boolean              @default(false)
  taxTag          TaxTag?
  lines           JournalLine[]
  bankAccounts    BankAccount[]
  sourceAccounts  SourceAccount[]
  scheduleDebits  AdjustmentSchedule[] @relation("ScheduleDebit")
  scheduleCredits AdjustmentSchedule[] @relation("ScheduleCredit")
  scheduleSources AdjustmentSchedule[] @relation("ScheduleSourceAccount")

  @@unique([clientId, code])
}

model BankAccount {
  id           String            @id @default(cuid())
  firmId       String
  entityId     String
  entity       Entity            @relation(fields: [entityId], references: [id])
  accountId    String
  account      Account           @relation(fields: [accountId], references: [id])
  bank         BankCode
  number       String
  label        String
  currency     String            @default("IDR")
  /// Pinjaman rekening koran (PRK): GL account in 2201–2209, balance may be negative.
  isOverdraft  Boolean           @default(false)
  imports      StatementImport[]
  transactions BankTransaction[]

  @@unique([entityId, number])
}

model Period {
  id         String         @id @default(cuid())
  firmId     String
  clientId   String
  client     Client         @relation(fields: [clientId], references: [id])
  year       Int
  month      Int
  status     PeriodStatus   @default(OPEN)
  lockedAt   DateTime?
  lockNote   String?
  lockedById String?
  lockedBy   FirmMember?    @relation("PeriodLockedBy", fields: [lockedById], references: [id])
  entries    JournalEntry[]
  acks       ControlAck[]
  signoffs   CloseSignoff[]

  @@unique([clientId, year, month])
}

model StatementImport {
  evidenceVersionId String?
  evidenceUnitKey   String?
  id                String            @id @default(cuid())
  firmId            String
  bankAccountId     String
  bankAccount       BankAccount       @relation(fields: [bankAccountId], references: [id])
  fileName          String
  format            BankCode
  periodStart       DateTime          @db.Date
  periodEnd         DateTime          @db.Date
  openingBalance    BigInt
  closingBalance    BigInt
  rowCount          Int
  duplicateCount    Int               @default(0)
  continuityOk      Boolean
  continuityNote    String?
  /// Choices the parser made that change how the file is read (direction from the balance, sheets joined), shown to the accountant.
  parseNotes        String[]          @default([])
  importedById      String?
  importedBy        FirmMember?       @relation("StatementImportedBy", fields: [importedById], references: [id])
  createdAt         DateTime          @default(now())
  transactions      BankTransaction[]

  @@unique([evidenceVersionId, evidenceUnitKey])
}

model BankTransaction {
  id            String          @id @default(cuid())
  firmId        String
  importId      String
  import        StatementImport @relation(fields: [importId], references: [id])
  bankAccountId String
  bankAccount   BankAccount     @relation(fields: [bankAccountId], references: [id])
  entityId      String
  date          DateTime        @db.Date
  description   String
  merchantKey   String
  direction     Direction
  /// Signed: positive = money in, negative = money out.
  amount        BigInt
  balance       BigInt?
  rowNumber     Int
  /// Workbook sources: the sheet the row is on; rowNumber counts within it.
  sourceSheet   String?
  rawRow        String
  hash          String
  status        TxStatus
  method        ClassifyMethod
  confidence    Float
  reason        String
  accountCode   String?
  suggestedCode String?
  taxTag        TaxTag?
  matchedTxId   String?
  entries       JournalEntry[]
  proposals     ProposedEntry[]
  createdAt     DateTime        @default(now())

  @@unique([bankAccountId, hash])
  @@index([entityId, date])
  @@index([status])
}

model JournalEntry {
  id                String               @id @default(cuid())
  firmId            String
  entityId          String
  entity            Entity               @relation(fields: [entityId], references: [id])
  periodId          String
  period            Period               @relation(fields: [periodId], references: [id])
  date              DateTime             @db.Date
  kind              EntryKind
  memo              String
  bankTransactionId String?
  bankTransaction   BankTransaction?     @relation(fields: [bankTransactionId], references: [id])
  ledgerImportId    String?
  ledgerImport      LedgerImport?        @relation(fields: [ledgerImportId], references: [id])
  /// Source rows of a ledger-derived entry, e.g. "20_OPCO_GL_MASTER!5-87".
  sourceRef         String?
  /// Installment of an adjustment schedule (C4); unique per schedule so a double click posts once.
  scheduleId        String?
  schedule          AdjustmentSchedule?  @relation("ScheduleEntries", fields: [scheduleId], references: [id], onDelete: Restrict)
  installment       Int?
  /// Schedules created from this entry (a fixed-asset purchase, a prepayment).
  schedulesFrom     AdjustmentSchedule[] @relation("ScheduleSource")
  /// The proposal this entry was posted from (close copilot, 1999 correction).
  proposal          ProposedEntry?
  /// Member who posted it; null for seeds and system postings ("Sistem").
  postedById        String?
  postedBy          FirmMember?          @relation("EntryPostedBy", fields: [postedById], references: [id])
  createdAt         DateTime             @default(now())
  lines             JournalLine[]

  @@unique([scheduleId, installment])
  @@index([entityId, date])
  @@index([bankTransactionId])
  @@index([ledgerImportId])
}

/// DB CHECK constraints (see migration): debit >= 0, credit >= 0, exactly one side non-zero.
model JournalLine {
  id              String         @id @default(cuid())
  firmId          String
  entryId         String
  entry           JournalEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entityId        String
  accountId       String
  account         Account        @relation(fields: [accountId], references: [id])
  date            DateTime       @db.Date
  debit           BigInt         @default(0)
  credit          BigInt         @default(0)
  memo            String?
  sourceAccountId String?
  sourceAccount   SourceAccount? @relation(fields: [sourceAccountId], references: [id])
  sourceRef       String?
  /// Foreign-currency line: original currency, amount in its minor units, rate = functional per 1 unit (decimal string).
  currency        String?
  fxAmount        BigInt?
  fxRate          String?

  @@index([entityId, accountId, date])
  @@index([accountId])
  @@index([sourceAccountId])
}

model Rule {
  id          String     @id @default(cuid())
  firmId      String
  firm        Firm       @relation(fields: [firmId], references: [id])
  clientId    String?
  client      Client?    @relation(fields: [clientId], references: [id])
  /// Case-insensitive substring of the normalized description.
  pattern     String
  direction   Direction?
  accountCode String
  taxTag      TaxTag?
  priority    Int        @default(100)
  source      String     @default("SEED")
  createdAt   DateTime   @default(now())
}

model Memory {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id])
  merchantKey String
  direction   Direction
  accountCode String
  taxTag      TaxTag?
  hits        Int       @default(1)
  updatedAt   DateTime  @updatedAt

  @@unique([clientId, merchantKey, direction])
}

/// Persistent LLM answer cache — the same merchant pattern is never paid for twice.
model AiSuggestion {
  id          String    @id @default(cuid())
  cacheKey    String    @unique
  merchantKey String
  direction   Direction
  accountCode String
  confidence  Float
  taxTag      TaxTag?
  reason      String
  model       String
  createdAt   DateTime  @default(now())
}

model AiUsage {
  id               String   @id @default(cuid())
  firmId           String
  firm             Firm     @relation(fields: [firmId], references: [id])
  at               DateTime @default(now())
  model            String
  keysRequested    Int
  cacheHits        Int
  calls            Int
  promptTokens     Int
  completionTokens Int
  ok               Boolean
  note             String?
}

model ControlAck {
  id         String      @id @default(cuid())
  periodId   String
  period     Period      @relation(fields: [periodId], references: [id])
  controlKey String
  note       String
  ackedById  String?
  ackedBy    FirmMember? @relation("AckDoneBy", fields: [ackedById], references: [id])
  createdAt  DateTime    @default(now())

  @@unique([periodId, controlKey])
}

model CloseSignoff {
  id       String      @id @default(cuid())
  periodId String
  period   Period      @relation(fields: [periodId], references: [id])
  key      String
  doneAt   DateTime    @default(now())
  doneById String?
  doneBy   FirmMember? @relation("SignoffDoneBy", fields: [doneById], references: [id])

  @@unique([periodId, key])
}

/// Deployment-wide settings edited in Pengaturan (e.g. AI key + model). Not firm data: survives demo reset.
/// Secret values are AES-256-GCM encrypted with SETTINGS_SECRET (lib/settings/secret.ts).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// An entity's own account as it appears in the client's files, mapped to one client Account (ADR 0006, rule 9a).
model SourceAccount {
  id             String        @id @default(cuid())
  firmId         String
  clientId       String
  entityId       String
  entity         Entity        @relation(fields: [entityId], references: [id])
  code           String
  name           String
  /// Names this code had in earlier files (code reused / chart migrated).
  previousNames  String[]      @default([])
  typeHint       AccountType?
  /// Neraca files: the section's term ("Long-term Liability" → NON_CURRENT). Only steers mapping suggestions.
  termHint       AccountTerm?
  /// Set for monetary foreign-currency accounts (revaluation, rule 6b).
  currency       String?
  /// Accepted mapping (set only by the accountant's click, rule 9a).
  accountId      String?
  account        Account?      @relation(fields: [accountId], references: [id])
  mappedBy       MapMethod?
  mappedById     String?
  mappedByMember FirmMember?   @relation("MappingAcceptedBy", fields: [mappedById], references: [id])
  /// Pending suggestion (rules or AI) — never used for posting until accepted.
  suggestedCode  String?
  suggestedBy    MapMethod?
  mapConfidence  Float?
  mapReason      String?
  lines          JournalLine[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([entityId, code])
  @@index([clientId])
}

/// A ledger or Neraca file: staged as DRAFT (rows + checks + mapping), then POSTED all-or-nothing.
model LedgerImport {
  evidenceVersionId String?
  evidenceUnitKey   String?
  id                String             @id @default(cuid())
  firmId            String
  clientId          String
  client            Client             @relation(fields: [clientId], references: [id])
  fileName          String
  fileHash          String
  sheetName         String
  mode              LedgerMode
  currencyMode      CurrencyMode       @default(FUNCTIONAL)
  status            LedgerImportStatus @default(DRAFT)
  /// Neraca mode: balance date. Ledger mode: first row date.
  periodStart       DateTime           @db.Date
  periodEnd         DateTime           @db.Date
  rowCount          Int
  groupCount        Int                @default(0)
  roundingTotal     BigInt             @default(0)
  /// Staged rows + entity mapping while DRAFT (JSON, bigint as string).
  data              Json
  createdAt         DateTime           @default(now())
  importedById      String?
  importedBy        FirmMember?        @relation("LedgerImportedBy", fields: [importedById], references: [id])
  postedAt          DateTime?
  postedById        String?
  postedBy          FirmMember?        @relation("LedgerPostedBy", fields: [postedById], references: [id])
  entries           JournalEntry[]
  checks            ImportCheck[]

  @@unique([evidenceVersionId, evidenceUnitKey])
  @@index([clientId, fileHash])
}

model ImportCheck {
  id             String        @id @default(cuid())
  ledgerImportId String
  ledgerImport   LedgerImport  @relation(fields: [ledgerImportId], references: [id], onDelete: Cascade)
  severity       CheckSeverity
  code           String
  message        String
  refs           String[]      @default([])
  entityId       String?
  date           DateTime?     @db.Date
  amount         BigInt?
  /// BLOCK checks that may be accepted (unbalanced group) — accepting posts the difference to 1999.
  accepted       Boolean       @default(false)

  @@index([ledgerImportId])
}

/// Rate = units of `quote` per 1 unit of `currency` (decimal string). Typed in or taken from a file — never fetched live.
model ExchangeRate {
  id        String     @id @default(cuid())
  firmId    String
  firm      Firm       @relation(fields: [firmId], references: [id])
  currency  String
  quote     String
  date      DateTime   @db.Date
  kind      RateKind   @default(SPOT)
  rate      String
  source    RateSource @default(MANUAL)
  note      String?
  createdAt DateTime   @default(now())

  @@unique([firmId, currency, quote, date, kind])
}

/// AI account-mapping answers, cached forever by (normalised name, type hint, coaVersion) — names only, never amounts.
model AiAccountMap {
  id          String   @id @default(cuid())
  cacheKey    String   @unique
  name        String
  typeHint    String?
  accountCode String
  confidence  Float
  reason      String
  model       String
  createdAt   DateTime @default(now())
}

model AiReservation {
  id      String   @id @default(cuid())
  firmId  String
  scope   String
  tokens  Int
  at      DateTime @default(now())
  settled Boolean  @default(false)

  @@index([firmId, at])
}

model DriveConnection {
  id           String   @id @default(cuid())
  firmId       String   @unique
  refreshToken String
  createdAt    DateTime @default(now())
}

model DriveOAuthState {
  id          String   @id
  firmId      String
  browserHash String
  expiresAt   DateTime
}

model EvidenceIntake {
  id             String             @id @default(cuid())
  firmId         String
  clientId       String?
  name           String
  sourceUrl      String?
  status         String             @default("READY")
  cursor         Json               @default("{}")
  issue          String?
  leaseToken     String?
  leaseUntil     DateTime?
  contextVersion Int                @default(1)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  documents      EvidenceDocument[]
  facts          EvidenceFact[]
  conflicts      EvidenceConflict[]
  messages       EvidenceMessage[]

  @@index([firmId, clientId])
}

model EvidenceDocument {
  approvedShortcutTarget String?
  id                     String            @id @default(cuid())
  firmId                 String
  intakeId               String
  intake                 EvidenceIntake    @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  sourceKey              String
  name                   String
  path                   String
  mimeType               String
  sourceUrl              String?
  remote                 Json              @default("{}")
  fingerprint            String?
  currentVersionId       String?
  excluded               Boolean           @default(false)
  status                 String            @default("PENDING")
  issue                  String?
  seenRun                String?
  versions               EvidenceVersion[]

  @@unique([intakeId, sourceKey])
  @@index([firmId, intakeId])
}

model EvidenceVersion {
  id         String            @id @default(cuid())
  firmId     String
  documentId String
  document   EvidenceDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  hash       String
  data       Bytes
  name       String
  size       Int
  units      Json              @default("[]")
  issues     Json              @default("[]")
  extracted  Boolean           @default(false)
  analyzed   Boolean           @default(false)
  createdAt  DateTime          @default(now())
  passages   EvidencePassage[]

  @@unique([documentId, hash])
  @@index([firmId])
}

model EvidencePassage {
  id        String          @id @default(cuid())
  firmId    String
  versionId String
  version   EvidenceVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  unitKey   String
  locator   String
  text      String

  @@index([firmId, versionId])
}

model EvidenceFact {
  id            String         @id @default(cuid())
  firmId        String
  intakeId      String
  intake        EvidenceIntake @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  versionId     String
  unitKey       String
  locator       String
  key           String
  value         String
  effectiveDate String?
  status        String         @default("PROPOSED")

  @@unique([intakeId, versionId, unitKey, key, value])
}

model EvidenceConflict {
  id         String         @id @default(cuid())
  firmId     String
  intakeId   String
  intake     EvidenceIntake @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  key        String
  kind       String
  message    String
  versionIds Json
  resolved   Boolean        @default(false)
  note       String?

  @@unique([intakeId, key])
}

model EvidenceSelection {
  bankAccountId String?
  id            String  @id @default(cuid())
  firmId        String
  intakeId      String
  versionId     String
  unitKey       String
  role          String
  entityId      String?
  periodStart   String?
  periodEnd     String?
  currency      String?
  confirmed     Boolean @default(false)
  importId      String?

  @@unique([versionId, unitKey])
  @@index([firmId, intakeId])
}

model EvidenceUpload {
  id            String   @id @default(cuid())
  firmId        String
  intakeId      String
  name          String
  totalBytes    Int
  receivedBytes Int      @default(0)
  data          Bytes
  createdAt     DateTime @default(now())

  @@index([firmId, intakeId])
}

model EvidenceMessage {
  id        String         @id @default(cuid())
  firmId    String
  intakeId  String
  intake    EvidenceIntake @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  question  String
  answer    Json
  scope     Json
  createdAt DateTime       @default(now())
}

model EvidenceAiCache {
  key       String   @id
  firmId    String
  scope     String
  payload   Json
  createdAt DateTime @default(now())

  @@index([firmId, scope])
}

/// A person who may open this firm's workspace. Identity (email + password) lives in Supabase Auth;
/// `userId` is `auth.users.id` (no FK: that schema is Supabase-managed, and DB tests run on plain Postgres).
/// Members are disabled, never deleted, so attribution on journals and sign-offs stays resolvable.
model FirmMember {
  id        String     @id @default(cuid())
  firmId    String
  firm      Firm       @relation(fields: [firmId], references: [id])
  userId    String     @unique @db.Uuid
  email     String     @unique
  name      String
  role      MemberRole @default(AKUNTAN)
  disabled  Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  postedEntries    JournalEntry[]       @relation("EntryPostedBy")
  signoffs         CloseSignoff[]       @relation("SignoffDoneBy")
  lockedPeriods    Period[]             @relation("PeriodLockedBy")
  acks             ControlAck[]         @relation("AckDoneBy")
  statementImports StatementImport[]    @relation("StatementImportedBy")
  ledgerImports    LedgerImport[]       @relation("LedgerImportedBy")
  ledgerPostings   LedgerImport[]       @relation("LedgerPostedBy")
  mappings         SourceAccount[]      @relation("MappingAcceptedBy")
  schedules        AdjustmentSchedule[] @relation("ScheduleCreatedBy")
  proposalsDecided ProposedEntry[]      @relation("ProposalDecidedBy")

  @@index([firmId])
}

enum MemberRole {
  ADMIN
  AKUNTAN
}

enum ScheduleKind {
  DEPRECIATION
  AMORTIZATION
  ACCRUAL
}

/// Recurring adjusting entry (accounting-rules 5a): each month's installment is proposed at read time and posted only by the
/// accountant's click through postJournal(). Amount is the total in minor units of the entity's functional currency.
model AdjustmentSchedule {
  id              String         @id @default(cuid())
  firmId          String
  clientId        String
  client          Client         @relation(fields: [clientId], references: [id])
  entityId        String
  entity          Entity         @relation(fields: [entityId], references: [id])
  kind            ScheduleKind
  memo            String
  debitAccountId  String
  debitAccount    Account        @relation("ScheduleDebit", fields: [debitAccountId], references: [id])
  creditAccountId String
  creditAccount   Account        @relation("ScheduleCredit", fields: [creditAccountId], references: [id])
  amount          BigInt
  months          Int
  startYear       Int
  startMonth      Int
  /// ACCRUAL: one reversal (sides swapped, dated the 1st) in the month after the last installment.
  reverse         Boolean        @default(false)
  /// The entry it came from (fixed-asset purchase, prepayment) — the rule 15 chain.
  sourceEntryId   String?
  sourceEntry     JournalEntry?  @relation("ScheduleSource", fields: [sourceEntryId], references: [id])
  /// The account of the source entry's line it came from: with sourceEntryId it names that one line (null on schedules made
  /// before it was stored, and on schedules without a source).
  sourceAccountId String?
  sourceAccount   Account?       @relation("ScheduleSourceAccount", fields: [sourceAccountId], references: [id])
  stoppedAt       DateTime?
  createdById     String?
  createdBy       FirmMember?    @relation("ScheduleCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime       @default(now())
  entries         JournalEntry[] @relation("ScheduleEntries")

  @@index([clientId])
  @@index([entityId])
}

enum ProposalSource {
  AI_CONTROL
  SUSPENSE
}

enum ProposalStatus {
  PROPOSED
  POSTED
  DISMISSED
}

/// A draft journal (accounting-rules 20b): proposed by the close copilot or a deterministic check, posted only by the accountant's
/// click through postJournal(). Lines are JSON [{accountCode, debit, credit}] in minor units (strings); only accounts may be edited.
model ProposedEntry {
  id                String           @id @default(cuid())
  firmId            String
  clientId          String
  client            Client           @relation(fields: [clientId], references: [id])
  entityId          String
  entity            Entity           @relation(fields: [entityId], references: [id])
  year              Int
  month             Int
  source            ProposalSource
  controlKey        String?
  /// Dedupe: one proposal per AI answer (input hash) or per suspense line.
  key               String           @unique
  memo              String
  lines             Json
  reason            String
  refs              String[]         @default([])
  /// AI drafts: hash of the control\'s rows when the draft was made; posting refuses if the books moved since.
  snapshot          String?
  status            ProposalStatus   @default(PROPOSED)
  /// Set when the draft re-classifies one bank line: posting goes through the review writer (rule 3), not a free journal.
  bankTransactionId String?
  bankTransaction   BankTransaction? @relation(fields: [bankTransactionId], references: [id])
  entryId           String?          @unique
  entry             JournalEntry?    @relation(fields: [entryId], references: [id], onDelete: Restrict)
  decidedById       String?
  decidedBy         FirmMember?      @relation("ProposalDecidedBy", fields: [decidedById], references: [id])
  decidedAt         DateTime?
  createdAt         DateTime         @default(now())

  @@index([clientId, year, month])
}
