# Local Postgres (docker compose up -d) — Neon pooled URL in production
DATABASE_URL=postgresql://buku:buku@localhost:5432/buku
# Enables synthetic demo fixtures; reset is operator-only tooling
DEMO_MODE=true
# OpenAI-compatible LLM gateway (OpenCode Zen). Leave AI_API_KEY empty to run rules-only.
AI_BASE_URL=https://opencode.ai/zen/v1
AI_API_KEY=
AI_MODEL=
AI_MAX_CALLS_PER_IMPORT=3
AI_MONTHLY_TOKEN_BUDGET=200000
# Same authenticated document experience in staging and main; false disables documents operationally
EVIDENCE_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Invitation-only access. Different values and user records in each environment.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# email (default), or shared-code for a temporary operator-distributed password.
AUTH_MODE=email
# Required only for shared-code: randomly generate 12 digits; never commit the value.
AUTH_SHARED_CODE=
# Login code delivery (email mode only). Configure a verified sender; never log codes in production.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
